{
  "id": null,
  "uid": "bank-churn-automl",
  "title": "Bank Churn ML Monitoring",
  "tags": ["ml", "bank-churn", "automl"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "ROC-AUC",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "model_roc_auc", "legendFormat": "ROC-AUC"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "F1-score",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "model_f1_score", "legendFormat": "F1"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Recall",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "model_recall_score", "legendFormat": "Recall"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Rows total",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "dataset_rows_total", "legendFormat": "Rows"}],
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Model quality",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "model_roc_auc", "legendFormat": "ROC-AUC"},
        {"expr": "model_f1_score", "legendFormat": "F1-score"},
        {"expr": "model_recall_score", "legendFormat": "Recall"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Dataset health",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "dataset_missing_values_total", "legendFormat": "Missing values"},
        {"expr": "churn_positive_rate", "legendFormat": "Positive churn rate"},
        {"expr": "avg_churn_probability", "legendFormat": "Avg churn probability"}
      ],
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Prediction requests",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "increase(prediction_requests_total[1m])", "legendFormat": "Requests per minute"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Prediction latency p95",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    }
  ]
}
